{
  "name": "personal-video-downloader-tv-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Video Downloader & TV Media Manager with FFmpeg TV compatibility encoding",
  "scripts": {
    "frontend:dev": "npm --prefix frontend run dev",
